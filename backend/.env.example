# NeoGrow backend environment variables.
# Copy this file to `.env` and fill in real values. The real `.env` is never committed.

# JWT signing secret. REQUIRED: the application refuses to start if it is not set.
# There is no default; generate a strong random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-generated-secret

# Comma-separated list of origins allowed to make credentialed CORS requests.
# Include every frontend URL that talks to this API (no trailing slash).
# Example (production): https://app.neogrow.com,https://neogrow.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SQLAlchemy connection URL for the PostgreSQL database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neogrow
